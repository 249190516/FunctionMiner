      <node index="12" text="How does OpenTracks store sensor data?" resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,657][1370,832]" />
      <node index="13" text=" Sensor data is stored per recorded location. In terms of a heart rate sensor, this means that only one heart rate measurement is stored per location. If you are standing still or are indoors, no sensor data will be recorded (but it will be shown). " resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,832][1370,1238]" />
      <node index="14" text="OpenTracks is not recording locations?" resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,1308][1370,1401]" />
      <node index="15" text=" What you can do:&#10; a) check if GPS is enabled,&#10; b) improve GPS reception (e.g., go outdoors),&#10; c) check with GPSTest app, and&#10; d) disable power saving.&#10; &#10; If everything does not help please report a bug. " resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,1401][1370,1873]" />
      <node index="16" text="How can I support OpenTracks?" resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,1943][1370,2036]" />
      <node index="17" text=" You can:&#10; a) spread the word about OpenTracks,&#10; b) propose features,&#10; c) report bugs,&#10; d) help in software development,&#10; e) buy in Google Play Store,&#10; f) donate, and&#10; g) do whatever you think helps OpenTracks. " resource-id="" class="android.widget.TextView" package="de.dennisguse.opentracks" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[70,2036][1370,2574]" />
