            <node index="0" text="How can I change lap sorting at the stopwatch tab?" resource-id="" class="android.widget.TextView" package="org.fossify.clock" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[56,336][1384,458]" />
